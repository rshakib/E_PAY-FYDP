# ============================================
# PII Encryption Keys
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================
PII_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY
PII_HMAC_PEPPER=REPLACE_WITH_64_CHAR_HEX_KEY

# ============================================
# Optional: Sandbox mode (uses in-memory fake DB)
# ============================================
SANDBOX_FAKE_DB=0

# ============================================
# AWS KMS — HSM-backed receiver ECDH key (paper §2, Mode B)
# ------------------------------------------------------------
# Leave AWS_KMS_ECDH_KEY_ID empty to keep using the software key
# (Vault / DB). When set, the receiver's private ECDH key stays inside
# the HSM and Z = ECDH(SK_R^dh, ePK) is computed by KMS per transfer.
#
# Create the key with:
#   aws kms create-key --key-usage KEY_AGREEMENT \
#       --key-spec ECC_NIST_P256 --description "HTE receiver ECDH"
#   aws kms create-alias --alias-name alias/hte-receiver-ecdh --target-key-id <KEY_ID>
#
# IAM: kms:DeriveSharedSecret, kms:GetPublicKey, kms:DescribeKey
# ============================================
# AWS_KMS_ECDH_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AWS_KMS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
